{
  "name": "stellar-trade-flow-mvp",
  "version": "1.0.0",
  "description": "Agent-driven buyer-seller trade flow with Stellar testnet escrow settlement",
  "private": true,
  "workspaces": [
    "services/*",
    "client"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "start:buyer": "node services/buyer-agent/index.js",
    "start:search": "node services/search-agent/index.js",
    "start:validation": "node services/validation-agent/index.js",
    "start:po": "node services/po-agent/index.js",
    "start:fulfillment": "node services/fulfillment-agent/index.js",
    "start:dvp": "node services/dvp-agent/index.js",
    "start:payment": "node services/payment-agent/index.js",
    "start:all": "concurrently \"npm run start:buyer\" \"npm run start:search\" \"npm run start:validation\" \"npm run start:po\" \"npm run start:fulfillment\" \"npm run start:dvp\" \"npm run start:payment\"",
    "client": "cd client && npm start",
    "demo": "node scripts/run_demo_e2e.js",
    "test": "jest",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "stellar-sdk": "^11.2.2",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.2",
    "crypto": "^1.0.1"
  }
}

